---
import type { GetStaticPaths } from 'astro';
import ProjectDetail from '../../components/ProjectDetail.astro';
import { loadProjects, type ProjectView } from '../../lib/projects.ts';

export const getStaticPaths = (async () => {
  const list = await loadProjects('es');
  return list.map((project, i) => ({
    params: { slug: project.slug },
    props: { project, prev: list[i - 1], next: list[i + 1] },
  }));
}) satisfies GetStaticPaths;

interface Props {
  project: ProjectView;
  prev?: ProjectView | undefined;
  next?: ProjectView | undefined;
}

const { project, prev, next } = Astro.props;
---

<ProjectDetail lang="es" project={project} prev={prev} next={next} />
