---
import { diagramThumb } from '../lib/diagram-thumb.ts';

interface Props {
  body: string | undefined;
  id: string;
  class?: string;
}

const { body, id, class: className } = Astro.props;
const thumb = await diagramThumb(body, `thumb-${id.replaceAll('/', '-')}`);
---

{
  thumb && (
    <img
      src={thumb.src}
      alt=""
      width={thumb.width}
      height={thumb.height}
      loading="lazy"
      decoding="async"
      class:list={['block h-full w-full object-contain', className]}
    />
  )
}
