---
/** Timeline de experiencia con revelado progresivo (la línea se dibuja por tramos). */
import { duration, formatDate } from '../lib/format.ts';
import type { CV } from '../lib/schema.ts';
import Rich from './Rich.astro';

interface Props {
  cv: CV;
  /** Máximo de logros por empleo (la home muestra un resumen; el CV, todos). */
  maxHighlights?: number;
  /** La home omite las tecnologías (ya están en el stack); el CV las muestra. */
  showTechnologies?: boolean;
}
const { cv, maxHighlights = 3, showTechnologies = true } = Astro.props;
/** Con logros agrupados: resumen (1 por grupo) en la home, todos en el CV. */
const perGroup = maxHighlights >= 8 ? undefined : 1;
const L = cv.meta.labels;
const lang = cv.meta.lang;
---

<ol class="timeline space-y-10">
  {
    cv.work.map((job) => (
      <li data-reveal>
        <span class="timeline-dot" aria-hidden="true" />
        <article>
          <header class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between sm:gap-6">
            <div>
              <h3 class="text-lg font-semibold tracking-tight text-ink sm:text-xl">{job.position}</h3>
              <p class="mt-0.5 text-sm font-medium text-accent-ink">
                {job.url ? <a href={job.url} class="hover:underline">{job.name}</a> : job.name}
                {job.location && <span class="text-muted"> · {job.location}</span>}
              </p>
            </div>
            <p class="shrink-0 font-mono text-xs text-muted tabular-nums">
              <time datetime={job.startDate}>{formatDate(job.startDate, L)}</time> –{' '}
              {job.endDate ? <time datetime={job.endDate}>{formatDate(job.endDate, L)}</time> : L.present}
              {job.startDate.includes('-') && (!job.endDate || job.endDate.includes('-')) && (
                <span> · {duration(job.startDate, job.endDate, lang)}</span>
              )}
            </p>
          </header>
          {job.summary && (
            <p class="mt-3 text-muted">
              <Rich text={job.summary} />
            </p>
          )}
          {job.highlights.length > 0 && (
            <ul class="mt-4 space-y-2 text-[15px] leading-relaxed text-muted">
              {job.highlights.slice(0, maxHighlights).map((h) => (
                <li class="relative pl-5 before:absolute before:top-[0.7em] before:left-0 before:size-1.5 before:rounded-full before:bg-accent/70">
                  <Rich text={h} />
                </li>
              ))}
            </ul>
          )}
          {job.groups.map((g) => (
            <section class="mt-5">
              <h4 class="font-mono text-[11px] font-medium tracking-[0.14em] text-accent-ink uppercase">{g.name}</h4>
              <ul class="mt-2 space-y-2 text-[15px] leading-relaxed text-muted">
                {g.highlights.slice(0, perGroup).map((h) => (
                  <li class="relative pl-5 before:absolute before:top-[0.7em] before:left-0 before:size-1.5 before:rounded-full before:bg-accent/70">
                    <Rich text={h} />
                  </li>
                ))}
              </ul>
            </section>
          ))}
          {showTechnologies && job.technologies.length > 0 && (
            <ul class="mt-4 flex flex-wrap gap-1.5" aria-label={L.technologies}>
              {job.technologies.slice(0, maxHighlights > 3 ? undefined : 10).map((tech) => (
                <li class="tag-mono">{tech}</li>
              ))}
            </ul>
          )}
        </article>
      </li>
    ))
  }
</ol>
