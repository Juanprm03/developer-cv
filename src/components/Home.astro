---
import Base from '../layouts/Base.astro';
import { loadCV } from '../lib/cv.ts';
import { anchors, cvFileName, cvHref, routes, ui } from '../lib/i18n.ts';
import { loadProjects } from '../lib/projects.ts';
import type { Lang } from '../lib/schema.ts';
import { withBase } from '../lib/url.ts';
import Approach from './Approach.astro';
import Contact from './Contact.astro';
import CvCta from './CvCta.astro';
import ExperienceTimeline from './ExperienceTimeline.astro';
import FiguresSection from './FiguresSection.astro';
import Icon from './Icon.astro';
import ProfileSection from './ProfileSection.astro';
import ProjectCard from './ProjectCard.astro';
import SectionHeader from './SectionHeader.astro';
import SiteNav from './SiteNav.astro';
import SystemGraph from './SystemGraph.astro';
import TechStack from './TechStack.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const cv = loadCV(lang);
const t = ui[lang];
const b = cv.basics;
const other: Lang = lang === 'es' ? 'en' : 'es';

const projects = await loadProjects(lang);
const featured = projects.filter((p) => p.featured).slice(0, 3);
const others = projects.filter((p) => !featured.includes(p));
---

<Base cv={cv} paths={routes.home}>
  <SiteNav lang={lang} current="home" altPath={routes.home[other]} name={b.name} />

  <main id="main">
    <!-- Hero -->
    <section
      class="spotlight relative -mt-16 overflow-hidden pt-16"
      data-spotlight
      aria-labelledby="hero-title"
    >
      <div class="grid-lines pointer-events-none absolute inset-0" aria-hidden="true"></div>
      <div
        class="container-page relative grid items-center gap-10 py-14 sm:py-20 lg:grid-cols-[minmax(0,1.05fr)_minmax(0,1fr)] lg:gap-12 lg:py-24"
      >
        <div data-stagger class="min-w-0">
          <p style="--i:0" class="eyebrow">{cv.home.kicker}</p>
          <h1
            id="hero-title"
            style="--i:1"
            class="mt-5 text-[2.6rem] leading-[1.04] font-semibold tracking-tight sm:text-6xl xl:text-7xl"
          >
            <span class="bg-gradient-to-br from-white via-ink to-accent-hover bg-clip-text text-transparent">{b.name}</span>
          </h1>
          <p style="--i:2" class="mt-6 max-w-2xl text-xl leading-snug font-medium text-pretty text-ink sm:text-2xl">
            {cv.home.headline}
          </p>
          <p style="--i:3" class="lead mt-4 max-w-2xl">{cv.home.intro}</p>
          <p
            style="--i:4"
            class="mt-6 inline-flex max-w-full items-start gap-2.5 rounded-xl border border-rule-strong bg-surface/70 px-3.5 py-2.5 text-sm text-muted backdrop-blur"
          >
            <Icon name="briefcase" class="mt-0.5 size-4 shrink-0 text-accent-ink" />
            <span>{cv.home.experience}</span>
          </p>

          <div style="--i:5" class="mt-8 flex flex-wrap gap-3">
            <a href={`#${anchors.projects}`} class="btn btn-primary">
              {t.ctaProjects}
              <Icon name="arrowRight" />
            </a>
            <a
              href={withBase(cvHref(b.name, lang))}
              download={cvFileName(b.name, lang)}
              hreflang={lang}
              type="application/pdf"
              class="btn btn-secondary"
            >
              <Icon name="download" />
              {t.heroCtaCv}
            </a>
            <a href={`#${anchors.contact}`} class="btn btn-ghost">
              <Icon name="mail" />
              {t.ctaContact}
            </a>
          </div>
        </div>

        <div data-stagger class="min-w-0">
          <div style="--i:3">
            <SystemGraph lang={lang} />
          </div>
        </div>
      </div>

      <!-- Áreas de especialización (en lugar de cifras sin respaldo suficiente). -->
      <div class="container-page relative pb-16 sm:pb-20">
        <ul class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3" data-stagger>
          {
            cv.home.specializations.map((s, i) => (
              <li
                style={`--i:${4 + i * 0.5}`}
                class="rounded-2xl border border-rule bg-surface/60 px-5 py-4 backdrop-blur"
              >
                <span class="block font-semibold text-ink">{s.title}</span>
                <span class="mt-1 block font-mono text-xs text-muted">{s.skills.join(' · ')}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <div class="container-page space-y-28 py-12 sm:space-y-36">
      <ProfileSection cv={cv} lang={lang} />

      <!-- Experiencia -->
      <section id={anchors.experience} aria-labelledby={`${anchors.experience}-title`} class="scroll-mt-24">
        <SectionHeader id={anchors.experience} kicker={t.experienceKicker} title={t.experienceTitle} />
        <div class="mt-12 max-w-4xl">
          <ExperienceTimeline cv={cv} maxHighlights={5} showTechnologies={false} />
        </div>
        <a href={withBase(routes.cv[lang])} class="link-arrow mt-10" data-reveal>
          {t.resumeView}
          <Icon name="arrowRight" class="size-4" />
        </a>
      </section>

      <FiguresSection cv={cv} lang={lang} />

      <!-- Proyectos -->
      <section id={anchors.projects} aria-labelledby={`${anchors.projects}-title`} class="scroll-mt-24">
        <div class="flex flex-wrap items-end justify-between gap-6">
          <SectionHeader id={anchors.projects} kicker={t.featuredKicker} title={t.featuredTitle} />
          <a href={withBase(routes.projects[lang])} class="link-arrow" data-reveal>
            {t.allCases} ({projects.length})
            <Icon name="arrowRight" class="size-4" />
          </a>
        </div>
        <ul class="mt-10 space-y-6">
          {
            featured.map((p, i) => (
              <li>
                <ProjectCard project={p} lang={lang} featured index={i} />
              </li>
            ))
          }
        </ul>
        <h3 class="mt-16 font-mono text-xs font-medium tracking-[0.18em] text-muted uppercase" data-reveal>
          {t.moreProjects}
        </h3>
        <ul class="mt-6 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
          {
            others.map((p, i) => (
              <li>
                <ProjectCard project={p} lang={lang} index={i} headingLevel={3} />
              </li>
            ))
          }
        </ul>
      </section>

      <!-- Experiencia técnica -->
      <section id={anchors.stack} aria-labelledby={`${anchors.stack}-title`} class="scroll-mt-24">
        <SectionHeader
          id={anchors.stack}
          kicker={t.techStackKicker}
          title={t.techStackTitle}
          intro={t.techStackIntro}
        />
        <div class="mt-10">
          <TechStack lang={lang} />
        </div>
      </section>

      <!-- Cómo trabajo -->
      <section id={anchors.principles} aria-labelledby={`${anchors.principles}-title`} class="scroll-mt-24">
        <SectionHeader
          id={anchors.principles}
          kicker={t.approachKicker}
          title={cv.home.approach.title}
          intro={cv.home.approach.intro}
        />
        <div class="mt-10">
          <Approach principles={cv.principles} lang={lang} />
        </div>
      </section>

      <CvCta lang={lang} name={b.name} />

      <Contact cv={cv} lang={lang} />
    </div>
  </main>
</Base>
