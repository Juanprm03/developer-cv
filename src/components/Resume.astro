---
import Base from '../layouts/Base.astro';
import { loadCV } from '../lib/cv.ts';
import { formatDate } from '../lib/format.ts';
import { cvFileName, cvHref, routes } from '../lib/i18n.ts';
import type { Lang } from '../lib/schema.ts';
import { prettyUrl, withBase } from '../lib/url.ts';
import Contact from './Contact.astro';
import ExperienceTimeline from './ExperienceTimeline.astro';
import Icon, { type IconName } from './Icon.astro';
import Rich from './Rich.astro';
import SiteNav from './SiteNav.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const cv = loadCV(lang);
const { basics, meta } = cv;
const L = meta.labels;
const otherLang: Lang = lang === 'es' ? 'en' : 'es';

const profileIcon = (network: string): IconName => {
  const n = network.toLowerCase();
  return n === 'linkedin' || n === 'github' ? n : 'link';
};

const card = 'print-flat card p-6 sm:p-8';
const heading =
  'mb-5 flex items-center gap-3 font-mono text-xs font-medium tracking-[0.16em] text-accent-ink uppercase after:h-px after:flex-1 after:bg-rule';
---

<Base cv={cv} paths={routes.cv}>
  <SiteNav lang={lang} current="cv" altPath={routes.cv[otherLang]} name={basics.name} />

  <main id="main" class="container-page py-10 sm:py-14">
    <!-- Cabecera del CV (no es <header>: el sitio ya tiene un landmark banner). -->
    <div class:list={[card, 'relative overflow-hidden']} data-stagger>
      <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-accent to-transparent" aria-hidden="true"></div>
      <div class="flex flex-col gap-8 md:flex-row md:items-start md:justify-between">
        <div class="min-w-0" style="--i:0">
          <h1 class="text-3xl font-semibold tracking-tight sm:text-5xl">{basics.name}</h1>
          <p class="mt-3 text-base font-medium text-pretty text-accent-ink sm:text-lg">{basics.label}</p>

          <ul class="mt-6 flex flex-wrap gap-x-5 gap-y-2 text-sm text-muted" aria-label={L.contact}>
            <li class="flex items-center gap-1.5">
              <Icon name="pin" class="size-4 shrink-0" />
              {basics.location.city}, {basics.location.country}
            </li>
            <li>
              <a href={`mailto:${basics.email}`} class="flex items-center gap-1.5 hover:text-ink">
                <Icon name="mail" class="size-4 shrink-0" />
                {basics.email}
              </a>
            </li>
            {
              basics.profiles.map((p) => (
                <li>
                  <a href={p.url} rel="me noopener" target="_blank" class="flex items-center gap-1.5 hover:text-ink">
                    <Icon name={profileIcon(p.network)} class="size-4 shrink-0" />
                    <span class="sr-only">{p.network}:</span>
                    {prettyUrl(p.url)}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="no-print flex shrink-0 flex-wrap gap-2 md:flex-col" style="--i:1">
          <a href={withBase(cvHref(basics.name, lang))} download={cvFileName(basics.name, lang)} hreflang={lang} type="application/pdf" class="btn btn-primary">
            <Icon name="download" />
            {L.downloadPdf}
          </a>
        </div>
      </div>
    </div>

    <div class="mt-6 grid gap-6 lg:grid-cols-[minmax(0,1fr)_21rem] print:block">
      <div class:list={[card, 'space-y-12']}>
        <section aria-labelledby="summary-title" data-reveal>
          <h2 id="summary-title" class={heading}>{L.summary}</h2>
          <p class="text-[17px] leading-relaxed text-pretty text-muted"><Rich text={basics.summary} /></p>
          <ul class="mt-5 flex flex-wrap gap-2" aria-label={L.competencies}>
            {cv.competencies.map((c) => <li class="chip">{c}</li>)}
          </ul>
        </section>

        <section aria-labelledby="work-title">
          <h2 id="work-title" class={heading}>{L.work}</h2>
          <ExperienceTimeline cv={cv} maxHighlights={8} />
        </section>

        {
          cv.projects.length > 0 && (
            <section aria-labelledby="projects-title">
              <h2 id="projects-title" class={heading}>{L.projects}</h2>
              <div class="space-y-7">
                {cv.projects.map((p) => (
                  <article data-reveal>
                    <h3 class="flex flex-wrap items-center gap-x-2 gap-y-1 font-semibold text-ink">
                      {p.caseStudy ? (
                        <a href={withBase(routes.project(p.caseStudy)[lang])} class="hover:text-accent-ink hover:underline">
                          {p.name}
                        </a>
                      ) : (
                        p.name
                      )}
                      {p.context === 'personal' && <span class="tag-mono">{L.personalProject}</span>}
                      {p.status === 'development' && <span class="tag-mono">{L.inDevelopment}</span>}
                      {p.status === 'stopped' && <span class="tag-mono">{L.devStopped}</span>}
                    </h3>
                    <p class="mt-1.5 leading-relaxed text-pretty text-muted">
                      <Rich text={p.description} />
                    </p>
                    {p.url && (
                      <a href={p.url} class="link-arrow mt-2 !font-medium" rel="noopener" target="_blank">
                        {prettyUrl(p.url)}
                        <Icon name="arrowUpRight" class="size-3.5" />
                      </a>
                    )}
                    {p.technologies.length > 0 && (
                      <ul class="mt-3 flex flex-wrap gap-1.5" aria-label={L.technologies}>
                        {p.technologies.map((tech) => (
                          <li class="tag-mono">{tech}</li>
                        ))}
                      </ul>
                    )}
                  </article>
                ))}
              </div>
            </section>
          )
        }
      </div>

      <aside class="space-y-6 print:mt-8">
        <section class={card} aria-labelledby="skills-title" data-reveal>
          <h2 id="skills-title" class={heading}>{L.skills}</h2>
          <dl class="space-y-5">
            {
              cv.skills.map((s) => (
                <div>
                  <dt class="text-sm font-semibold text-ink">{s.name}</dt>
                  <dd class="mt-2">
                    <ul class="flex flex-wrap gap-1.5">
                      {s.featured.map((k) => <li class="chip-accent">{k}</li>)}
                      {s.keywords.map((k) => <li class="chip">{k}</li>)}
                    </ul>
                  </dd>
                </div>
              ))
            }
          </dl>
        </section>

        <div class:list={[card, 'space-y-9']} data-reveal>
          <section aria-labelledby="education-title">
            <h2 id="education-title" class={heading}>{L.education}</h2>
            <ul class="space-y-3">
              {
                cv.education.map((e) => (
                  <li>
                    <p class="leading-snug font-semibold text-ink">
                      {e.studyType} {L.degreeIn} {e.area}
                    </p>
                    <p class="mt-1 text-sm text-muted">
                      {e.institution} ·{' '}
                      {e.startDate && <><time datetime={e.startDate}>{formatDate(e.startDate, L)}</time> – </>}
                      <time datetime={e.endDate}>{formatDate(e.endDate, L)}</time>
                    </p>
                  </li>
                ))
              }
            </ul>
          </section>

          {
            cv.certificates.length > 0 && (
              <section aria-labelledby="certificates-title">
                <h2 id="certificates-title" class={heading}>{L.certificates}</h2>
                <ul class="space-y-2 text-sm">
                  {cv.certificates.map((c) => (
                    <li class="flex items-baseline justify-between gap-3">
                      <span class="text-ink">{c.url ? <a href={c.url} class="hover:underline">{c.name}</a> : c.name}</span>
                      {(c.issuer || c.date) && (
                        <span class="shrink-0 font-mono text-xs text-muted">
                          {[c.issuer, c.date && formatDate(c.date, L)].filter(Boolean).join(' · ')}
                        </span>
                      )}
                    </li>
                  ))}
                </ul>
              </section>
            )
          }

          <section aria-labelledby="languages-title">
            <h2 id="languages-title" class={heading}>{L.languages}</h2>
            <dl class="space-y-2 text-sm">
              {
                cv.languages.map((l) => (
                  <div class="flex justify-between gap-3">
                    <dt class="font-semibold text-ink">{l.language}</dt>
                    <dd class="text-muted">{l.fluency}</dd>
                  </div>
                ))
              }
            </dl>
          </section>
        </div>
        {
          cv.knowledge.length > 0 && (
            <section class={card} aria-labelledby="knowledge-title" data-reveal>
              <h2 id="knowledge-title" class={heading}>{L.knowledge}</h2>
              <dl class="space-y-4">
                {(
                  [
                    ['personal', L.knowledgePersonal],
                    ['learning', L.knowledgeLearning],
                  ] as const
                ).map(([ctx, label]) => {
                  const items = cv.knowledge.filter((k) => k.context === ctx);
                  return (
                    items.length > 0 && (
                      <div>
                        <dt class="text-sm font-semibold text-ink">{label}</dt>
                        <dd class="mt-2">
                          <ul class="flex flex-wrap gap-1.5">
                            {items.map((k) => <li class="chip">{k.name}</li>)}
                          </ul>
                        </dd>
                      </div>
                    )
                  );
                })}
              </dl>
              <p class="mt-3 text-xs leading-relaxed text-muted italic">{L.knowledgeNote}</p>
            </section>
          )
        }

      </aside>
    </div>


    <div class="mt-24">
      <Contact cv={cv} lang={lang} />
    </div>
  </main>
</Base>
