---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { loadCV } from '../lib/cv.ts';
import { routes, ui } from '../lib/i18n.ts';
import type { ProjectView } from '../lib/projects.ts';
import type { Lang } from '../lib/schema.ts';
import { prettyUrl, withBase } from '../lib/url.ts';
import Contact from './Contact.astro';
import Icon from './Icon.astro';
import SiteNav from './SiteNav.astro';

interface Props {
  lang: Lang;
  project: ProjectView;
  prev?: ProjectView | undefined;
  next?: ProjectView | undefined;
}

const { lang, project: p, prev, next } = Astro.props;
const cv = loadCV(lang);
const t = ui[lang];
const other: Lang = lang === 'es' ? 'en' : 'es';
const { Content, headings } = await render(p.entry);
const toc = headings.filter((h) => h.depth === 2);
const site = Astro.site ?? new URL('http://localhost:4321');

const facts: [string, string][] = [
  [p.context === 'professional' ? t.company : t.context, p.organization],
  [t.role, p.role],
];
if (p.status)
  facts.push([
    t.status,
    { development: t.statusDevelopment, stopped: t.statusStopped, production: t.statusProduction }[
      p.status
    ],
  ]);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: p.title,
  description: p.tagline,
  inLanguage: lang,
  url: new URL(withBase(routes.project(p.slug)[lang]), site).href,
  author: { '@type': 'Person', name: cv.basics.name, url: cv.basics.url },
  about: p.technologies,
  ...(p.url && { codeRepository: p.url }),
};
---

<Base
  cv={cv}
  title={`${p.title} — ${cv.basics.name}`}
  description={p.tagline}
  paths={routes.project(p.slug)}
  jsonLd={jsonLd}
  ogType="article"
>
  <SiteNav lang={lang} current="projects" altPath={routes.project(p.slug)[other]} name={cv.basics.name} />

  <main id="main" class="container-page py-10 lg:py-14">
    <a href={withBase(routes.projects[lang])} class="link-arrow !text-muted hover:!text-ink">
      <Icon name="arrowLeft" class="size-4" />
      {t.allProjects}
    </a>

    <header class="mt-8 max-w-4xl" data-stagger>
      <div class="flex flex-wrap items-center gap-2" style="--i:0">
        <span class="chip-accent">{p.context === 'personal' ? t.personal : t.professional}</span>
        {
          p.status === 'development' && (
            <span class="chip border-amber-400/30 bg-amber-400/10 text-amber-200">{t.statusDevelopment}</span>
          )
        }
        {
          p.status === 'stopped' && <span class="chip text-muted">{t.statusStopped}</span>
        }
        {
          p.confidential && (
            <span class="chip gap-1.5">
              <Icon name="lock" class="size-3" />
              {t.confidential}
            </span>
          )
        }
      </div>
      <h1 class="mt-5 text-4xl leading-tight font-semibold tracking-tight sm:text-6xl" style="--i:1">{p.title}</h1>
      <p class="lead mt-5" style="--i:2">{p.tagline}</p>

      {
        p.url && (
          <a href={p.url} rel="noopener" target="_blank" class="btn btn-secondary mt-7" style="--i:3">
            <Icon name={p.url.includes('github.com') ? 'github' : 'externalLink'} class="size-4" />
            {prettyUrl(p.url)}
            <Icon name="arrowUpRight" class="size-3.5 opacity-60" />
          </a>
        )
      }
    </header>

    <dl class:list={['mt-10 grid gap-3', facts.length === 3 ? 'sm:grid-cols-3' : 'sm:grid-cols-2']} data-reveal>
      {
        facts.map(([k, v]) => (
          <div class="card p-4">
            <dt class="font-mono text-[11px] tracking-[0.14em] text-muted uppercase">{k}</dt>
            <dd class="mt-1.5 font-medium text-ink">{v}</dd>
          </div>
        ))
      }
    </dl>

    {
      p.metrics.length > 0 && (
        <section class="mt-3" aria-label={t.metrics} data-reveal>
          <dl class="grid grid-cols-2 gap-3 lg:grid-cols-4">
            {p.metrics.map((m) => (
              <div class="card p-4">
                <dt class="text-xs leading-snug text-muted">{m.label}</dt>
                <dd class="mt-1 font-mono text-2xl font-semibold text-accent-ink">{m.value}</dd>
              </div>
            ))}
          </dl>
        </section>
      )
    }

    <section aria-labelledby="stack-title" class="card mt-3 p-5 sm:p-6" data-reveal>
      <h2 id="stack-title" class="font-mono text-[11px] tracking-[0.14em] text-muted uppercase">{t.stack}</h2>
      <ul class="mt-3 flex flex-wrap gap-1.5">
        {p.technologies.map((tech) => <li class="chip">{tech}</li>)}
      </ul>
    </section>

    {
      toc.length > 0 && (
        <nav aria-labelledby="toc-title" class="no-print mt-10">
          <h2 id="toc-title" class="sr-only">{t.onThisPage}</h2>
          <ol class="flex flex-wrap gap-2 text-sm">
            {toc.map((h, i) => (
              <li>
                <a
                  href={`#${h.slug}`}
                  class="inline-flex items-center gap-2 rounded-full border border-rule-strong px-3 py-1.5 text-muted transition-colors hover:border-accent/60 hover:text-ink"
                >
                  <span class="font-mono text-xs text-accent-ink">{String(i + 1).padStart(2, '0')}</span>
                  {h.text}
                </a>
              </li>
            ))}
          </ol>
        </nav>
      )
    }

    <article class="prose-cv prose prose-lg mt-6 max-w-none prose-headings:font-semibold prose-headings:tracking-tight prose-h2:mt-14 prose-a:underline-offset-4">
      <Content />
    </article>

    {
      p.confidential && (
        <p class="mt-10 flex max-w-3xl gap-2 text-xs leading-relaxed text-muted">
          <Icon name="lock" class="mt-0.5 size-3.5 shrink-0" />
          {t.nda}
        </p>
      )
    }

    <nav class="no-print mt-20 grid gap-4 sm:grid-cols-2" aria-label={t.allProjects}>
      {
        prev ? (
          <a href={withBase(routes.project(prev.slug)[lang])} class="project-card group p-5">
            <span class="flex items-center gap-1.5 font-mono text-xs text-muted">
              <Icon name="arrowLeft" class="size-3.5" /> {t.prev}
            </span>
            <span class="mt-2 block font-semibold text-ink">{prev.title}</span>
          </a>
        ) : (
          <span />
        )
      }
      {
        next && (
          <a href={withBase(routes.project(next.slug)[lang])} class="project-card group p-5 text-right">
            <span class="flex items-center justify-end gap-1.5 font-mono text-xs text-muted">
              {t.next} <Icon name="arrowRight" class="size-3.5" />
            </span>
            <span class="mt-2 block font-semibold text-ink">{next.title}</span>
          </a>
        )
      }
    </nav>

    <div class="mt-24">
      <Contact cv={cv} lang={lang} />
    </div>
  </main>
</Base>
