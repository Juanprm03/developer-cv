---
import { anchors, ui } from '../lib/i18n.ts';
import type { CV, Lang } from '../lib/schema.ts';
import { prettyUrl } from '../lib/url.ts';
import Icon, { type IconName } from './Icon.astro';

interface Props {
  cv: CV;
  lang: Lang;
}

const { cv, lang } = Astro.props;
const t = ui[lang];
const b = cv.basics;
const icon = (network: string): IconName => {
  const n = network.toLowerCase();
  return n === 'linkedin' || n === 'github' ? n : 'link';
};
---

<section id={anchors.contact} aria-labelledby="contact-title" class="no-print scroll-mt-24">
  <div
    class="spotlight relative overflow-hidden rounded-3xl border border-rule-strong bg-surface px-6 py-14 text-center sm:px-12 sm:py-20"
    data-spotlight
    data-reveal
  >
    <div class="grid-lines pointer-events-none absolute inset-0" aria-hidden="true"></div>
    <div
      class="pointer-events-none absolute inset-x-0 -top-32 mx-auto h-64 w-2/3 rounded-full bg-accent/20 blur-3xl"
      aria-hidden="true"
    >
    </div>
    <p class="eyebrow relative">{t.contactKicker}</p>
    <h2 id="contact-title" class="relative mt-3 text-3xl font-semibold tracking-tight sm:text-5xl">
      {t.contactTitle}
    </h2>
    <p class="relative mx-auto mt-4 max-w-xl text-pretty text-muted">{t.contactText}</p>
    <a href={`mailto:${b.email}`} class="btn btn-primary relative mt-8">
      <Icon name="mail" />
      {b.email}
    </a>
    <ul class="relative mt-6 flex flex-wrap justify-center gap-3">
      {
        b.profiles.map((p) => (
          <li>
            <a href={p.url} rel="me noopener" target="_blank" class="btn btn-secondary !py-2">
              <Icon name={icon(p.network)} class="size-4" />
              <span class="sr-only">{p.network}:</span>
              {prettyUrl(p.url)}
              <Icon name="arrowUpRight" class="size-3.5 opacity-60" />
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
