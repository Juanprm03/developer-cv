---
import Base from '../layouts/Base.astro';
import { loadCV } from '../lib/cv.ts';
import { routes, ui } from '../lib/i18n.ts';
import { FILTER_CATEGORIES, techOptions } from '../lib/project-filters.ts';
import { loadProjects } from '../lib/projects.ts';
import type { Lang } from '../lib/schema.ts';
import { withBase } from '../lib/url.ts';
import Contact from './Contact.astro';
import ProjectCard from './ProjectCard.astro';
import SiteNav from './SiteNav.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const cv = loadCV(lang);
const t = ui[lang];
const other: Lang = lang === 'es' ? 'en' : 'es';
const projects = await loadProjects(lang);
const categories = FILTER_CATEGORIES.map((id) => ({
  id,
  label: t.categories[id],
  count: projects.filter((p) => p.categories.includes(id)).length,
})).filter((c) => c.count > 0);
const techs = techOptions(
  projects.map((p) => ({
    technologies: p.techIds.map((id, i) => ({ id, name: p.technologies[i] ?? id })),
  })),
);

const title = `${t.projectsTitle} — ${cv.basics.name}`;
const description = t.projectsIntro;
const site = Astro.site ?? new URL('http://localhost:4321');
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: title,
  description,
  inLanguage: lang,
  author: { '@type': 'Person', name: cv.basics.name },
  hasPart: projects.map((p) => ({
    '@type': 'CreativeWork',
    name: p.title,
    description: p.tagline,
    url: new URL(withBase(routes.project(p.slug)[lang]), site).href,
  })),
};
---

<Base cv={cv} title={title} description={description} paths={routes.projects} jsonLd={jsonLd} ogType="website">
  <SiteNav lang={lang} current="projects" altPath={routes.projects[other]} name={cv.basics.name} />

  <main id="main" class="container-page py-14 sm:py-20">
    <header class="max-w-3xl" data-stagger>
      <p class="eyebrow" style="--i:0">{t.projectsKicker}</p>
      <h1 class="mt-3 text-4xl font-semibold tracking-tight sm:text-6xl" style="--i:1">{t.projectsTitle}</h1>
      <p class="lead mt-5" style="--i:2">{t.projectsIntro}</p>
    </header>

    <!-- Filtros en dos niveles: ocultos sin JS (se ven todos los proyectos). -->
    <div data-filters hidden class="mt-12 rounded-2xl border border-rule bg-surface/60 p-4 sm:p-5">
      <div class="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
        <div class="min-w-0">
          <p id="filter-cat-label" class="sr-only">{t.filterCategory}</p>
          <div class="-mx-1 flex gap-2 overflow-x-auto px-1 pb-1 sm:flex-wrap sm:overflow-visible" role="group" aria-labelledby="filter-cat-label">
            <button type="button" data-category="all" aria-pressed="true" class="filter-chip shrink-0">
              {t.filterAll}
            </button>
            {
              categories.map((c) => (
                <button type="button" data-category={c.id} aria-pressed="false" class="filter-chip shrink-0">
                  {c.label} <span class="font-mono text-[11px] opacity-60">{c.count}</span>
                </button>
              ))
            }
          </div>
        </div>
        <div class="flex flex-wrap items-center gap-3">
          <label for="filter-tech" class="sr-only">{t.filterTech}</label>
          <select
            id="filter-tech"
            data-tech
            class="w-full rounded-full border border-rule-strong bg-surface px-4 py-2 text-sm text-ink transition-colors hover:border-accent/60 sm:w-60"
          >
            <option value="all">{t.filterAllTech}</option>
            {techs.map((x) => <option value={x.id}>{x.name}</option>)}
          </select>
          <button type="button" data-reset hidden class="btn btn-ghost shrink-0 !px-3 !py-2 text-sm">
            {t.filterReset}
          </button>
        </div>
      </div>
      <p data-filter-status class="sr-only" aria-live="polite"></p>
    </div>

    <div data-empty hidden class="mt-10 rounded-2xl border border-dashed border-rule-strong p-8 text-center">
      <p class="font-medium text-ink">{t.filterEmpty}</p>
      <button type="button" data-reset class="btn btn-secondary mt-4">{t.filterReset}</button>
    </div>

    <ol class="mt-10 grid gap-6 md:grid-cols-2">
      {
        projects.map((p, i) => (
          <li
            data-project
            data-categories={p.categories.join(' ')}
            data-techs={p.techIds.join(' ')}
            class:list={[p.featured && 'md:col-span-2']}
          >
            <ProjectCard project={p} lang={lang} featured={p.featured} index={i} headingLevel={2} />
          </li>
        ))
      }
    </ol>

    <div class="mt-28">
      <Contact cv={cv} lang={lang} />
    </div>
  </main>
</Base>

<script is:inline data-count-label={t.filterCount}>
  (() => {
    const root = document.querySelector('[data-filters]');
    if (!root) return;
    const items = [...document.querySelectorAll('[data-project]')];
    const chips = [...root.querySelectorAll('[data-category]')];
    const select = root.querySelector('[data-tech]');
    const resets = [...document.querySelectorAll('[data-reset]')];
    const empty = document.querySelector('[data-empty]');
    const status = root.querySelector('[data-filter-status]');
    const label = document.currentScript?.dataset.countLabel ?? '';
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let category = 'all';
    root.hidden = false;
    const has = (el, key, value) => value === 'all' || (el.dataset[key] ?? '').split(' ').includes(value);
    const apply = () => {
      let shown = 0;
      for (const item of items) {
        const match = has(item, 'categories', category) && has(item, 'techs', select.value);
        item.hidden = !match;
        if (match) shown++;
      }
      for (const c of chips) c.setAttribute('aria-pressed', String(c.dataset.category === category));
      // Tecnologías sin proyectos en la categoría elegida: deshabilitadas, no ocultas.
      for (const opt of select.options)
        opt.disabled = opt.value !== 'all' && !items.some((i) => has(i, 'categories', category) && has(i, 'techs', opt.value));
      const filtered = category !== 'all' || select.value !== 'all';
      for (const r of resets) if (!r.closest('[data-empty]')) r.hidden = !filtered;
      if (empty) empty.hidden = shown > 0;
      if (status) status.textContent = `${shown} ${label}`;
    };
    const run = () => (document.startViewTransition && !reduce ? document.startViewTransition(apply) : apply());
    for (const c of chips)
      c.addEventListener('click', () => {
        category = c.dataset.category;
        run();
      });
    select.addEventListener('change', run);
    for (const r of resets)
      r.addEventListener('click', () => {
        category = 'all';
        select.value = 'all';
        run();
        chips[0]?.focus();
      });
    apply();
  })();
</script>
