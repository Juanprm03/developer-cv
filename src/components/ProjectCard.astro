---
/**
 * Tarjeta de proyecto. Toda la tarjeta es clicable mediante el enlace del título
 * (after:absolute), así que el foco de teclado y el hover comparten estilos (:focus-within).
 */
import { Image } from 'astro:assets';
import { routes, ui } from '../lib/i18n.ts';
import type { ProjectView } from '../lib/projects.ts';
import type { Lang } from '../lib/schema.ts';
import { withBase } from '../lib/url.ts';
import DiagramThumb from './DiagramThumb.astro';
import Icon from './Icon.astro';

interface Props {
  project: ProjectView;
  lang: Lang;
  /** Tarjeta grande con miniatura del diagrama (proyectos destacados). */
  featured?: boolean;
  /** Índice para escalonar el revelado. */
  index?: number;
  /** Nivel del título según la jerarquía de la página (h2 en el catálogo, h3 en la home). */
  headingLevel?: 2 | 3;
}

const { project: p, lang, featured = false, index = 0, headingLevel = 3 } = Astro.props;
const Heading = headingLevel === 2 ? 'h2' : 'h3';
const t = ui[lang];
const href = withBase(routes.project(p.slug)[lang]);
const titleId = `project-${p.slug}`;
---

<article
  class:list={['project-card spotlight group flex h-full', featured ? 'flex-col lg:flex-row' : 'flex-col']}
  data-spotlight
  data-reveal
  style={`--d:${index % 3}`}
  aria-labelledby={titleId}
>
  {
    featured && (
      <div class="project-thumb relative shrink-0 overflow-hidden border-b border-rule bg-bg/60 lg:w-[46%] lg:border-r lg:border-b-0">
        <div class="grid-lines absolute inset-0" aria-hidden="true" />
        {p.entry.data.cover ? (
          <Image
            src={p.entry.data.cover}
            alt=""
            widths={[480, 800, 1200]}
            sizes="(min-width: 1024px) 480px, 100vw"
            class="relative block h-full w-full object-cover"
          />
        ) : (
          <div class="relative h-56 p-6 sm:h-64 lg:h-full lg:min-h-72">
            <DiagramThumb body={p.entry.body} id={p.entry.id} class="h-full" />
          </div>
        )}
      </div>
    )
  }

  <div class:list={['flex flex-1 flex-col', featured ? 'p-6 sm:p-8 lg:p-10' : 'p-6 sm:p-7']}>
    <div class="flex flex-wrap items-center gap-2 font-mono text-[11px] text-muted">
      <span>{p.organization}</span>
      {
        p.status === 'development' && (
          <span class="inline-flex items-center gap-1.5 rounded-full border border-amber-400/30 bg-amber-400/10 px-2 py-0.5 text-amber-200">
            <span class="size-1.5 rounded-full bg-amber-300" aria-hidden="true" />
            {t.statusDevelopment}
          </span>
        )
      }
      {
        p.status === 'stopped' && (
          <span class="inline-flex items-center gap-1.5 rounded-full border border-rule-strong px-2 py-0.5 text-muted">
            <span class="size-1.5 rounded-full bg-muted" aria-hidden="true" />
            {t.statusStopped}
          </span>
        )
      }
      {
        p.confidential && (
          <span class="inline-flex items-center gap-1">
            <Icon name="lock" class="size-3" />
            {t.confidential}
          </span>
        )
      }
    </div>

    <Heading
      id={titleId}
      class:list={['mt-3 font-semibold tracking-tight text-ink', featured ? 'text-2xl sm:text-[1.7rem]' : 'text-xl']}
    >
      <a href={href} class="rounded-sm outline-none after:absolute after:inset-0 after:rounded-2xl focus-visible:after:outline-2 focus-visible:after:outline-offset-[-2px] focus-visible:after:outline-accent-hover">
        {p.title}
      </a>
    </Heading>
    <p class="mt-3 leading-relaxed text-pretty text-muted">{p.tagline}</p>

    <ul class="mt-5 flex flex-wrap gap-1.5" aria-label={t.stack}>
      {p.technologies.slice(0, featured ? 7 : 5).map((tech) => <li class="tag-mono">{tech}</li>)}
    </ul>

    <p class="mt-auto flex items-center gap-1.5 pt-6 text-sm font-semibold text-accent-ink" aria-hidden="true">
      {t.readCase}
      <Icon name="arrowRight" class="size-4 transition-transform duration-300 group-hover:translate-x-1" />
    </p>
  </div>
</article>
