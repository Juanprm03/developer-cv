{
  "name": "developer-cv",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm pdf && astro dev",
    "build": "pnpm validate && pnpm pdf && pnpm pdf:check && astro build && pnpm check:links && pnpm check:public",
    "preview": "astro preview",
    "pdf": "node scripts/build-pdf.ts",
    "pdf:watch": "node --watch-path=data --watch-path=typst --watch-path=src/lib scripts/build-pdf.ts general",
    "validate": "node scripts/validate.ts",
    "check": "pnpm validate && astro check && biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "release": "CV_RELEASE=1 pnpm build",
    "pdf:check": "node scripts/check-pdf.ts",
    "check:links": "node scripts/check-links.ts",
    "a11y": "node scripts/a11y.ts",
    "check:public": "node scripts/check-public.ts"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.1",
    "@astrojs/mdx": "^8.0.2",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "astro": "^7.3.5",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "^2.5.14",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.3",
    "mermaid-isomorphic": "3.1.0",
    "playwright": "^1.63.0",
    "rehype-mermaid": "^3.0.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "unist-util-visit": "^5.1.0",
    "vitest": "4.1.12"
  }
}
